# Copy to commandcode.env and fill in your key. Values must NOT be quoted (docker --env-file keeps quotes literally).
# Claude Code appends /v1/messages to the base URL.
ANTHROPIC_BASE_URL=https://api.commandcode.ai/provider
ANTHROPIC_AUTH_TOKEN=your-command-code-key
# Only the claude-* models on Command Code serve /messages (others are /chat/completions only)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-5-5
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-5-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5-20251001
CLAUDE_CODE_SUBAGENT_MODEL=claude-sonnet-5-5
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
