# Copy to .env (docker compose reads it automatically)
OPENCODE_API_KEY=your-opencode-key
# Full proxy access, for the host only. cc.sh generates one when it is the default.
LITELLM_MASTER_KEY=sk-local-change-me
# Claude Code uses this key. It can only call the model routes. cc.sh fills it when empty.
LITELLM_CLIENT_KEY=
# Sent as x-opencode-session. cc.sh fills it with a new UUID when empty.
OPENCODE_SESSION_ID=

# Optional: folder mounted into the container (default: an empty volume)
# WORKSPACE=/path/to/your/project

# Optional: model slots (names from litellm/config.yaml)
# MAIN_MODEL=deepseek-v4-pro
# OPUS_MODEL=kimi-k3
# SONNET_MODEL=deepseek-v4-pro
# HAIKU_MODEL=deepseek-v4.1-flash
# SUBAGENT_MODEL=deepseek-v4-pro
